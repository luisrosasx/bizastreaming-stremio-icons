{
    "name": "@stremio/stremio-icons",
    "version": "5.15.0",
    "description": "Icon set for all Stremio clients",
    "author": {
        "name": "Smart Code Ltd.",
        "email": "office@stremio.com",
        "url": "https://stremio.com"
    },
    "license": "MIT",
    "private": true,
    "exports": {
        "./react": {
            "types": "./react/dist/index.d.ts",
            "import": "./react/dist/index.js",
            "require": "./react/dist/index.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Stremio/stremio-icons.git"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "prepare": "run-s \"build -- react\" build:react clean:react-manifest",
        "clean:react-manifest": "node -e \"require('fs').rmSync('react/package.json', { force: true })\"",
        "build:android": "npm run build -- android",
        "build:react": "npm install --prefix react && npm run build --prefix react",
        "build:solid": "npm install --prefix solid && npm run build --prefix solid",
        "build:jade": "npm run build -- jade",
        "build:all": "run-s \"build -- all\" build:react build:solid"
    },
    "devDependencies": {
        "change-case": "^4.1.2",
        "glob": "^8.1.0",
        "npm-run-all": "^4.1.5",
        "xml-js": "^1.6.11"
    }
}